{
  "schemaVersion": 1,
  "id": "mlumm",
  "version": "${version}",
  "name": "mlum mod",
  "description": "Utility tools, stat trackers, quality of life features, and improvements for play.mlum.io",
  "authors": [
    "darkpotatoo",
    "hotpocket184 (original mod)"
  ],
  "contact": {
    "sources": "https://github.com/darkpotatoo/mlum-mod"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/mlumm/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.darkpotatoo.mlumm.client.MlummClient"
    ],
    "main": [
      "me.darkpotatoo.mlumm.Mlumm"
    ],
    "modmenu": [
      "me.darkpotatoo.mlumm.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "mlumm.mixins.json",
    {
      "config": "mlumm.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": ">=1.21",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/ZSd8fXkj8r"
      },
      "update_checker": true
    }
  }
}
